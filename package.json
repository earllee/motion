{
  "name": "motion",
  "productName": "Motion",
  "version": "0.1.1",
  "description": "A Notion-style Markdown editor run fully locally, for agent-first knowledge bases and repos",
  "main": "./out/main/index.js",
  "author": "Earl Lee",
  "license": "MIT",
  "homepage": "https://github.com/earllee/motion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earllee/motion.git"
  },
  "bugs": "https://github.com/earllee/motion/issues",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --mac --dir && codesign --force --deep --sign - release/mac-arm64/Motion.app",
    "dist": "electron-vite build && electron-builder --mac",
    "release": "sh scripts/release.sh",
    "e2e": "electron-vite build && node scripts/e2e.mjs",
    "media": "electron-vite build && node scripts/demo.mjs && node scripts/social-card.mjs",
    "icon": "sh scripts/build-icon.sh"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@floating-ui/dom": "^1.8.0",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "codemirror": "^6.0.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lowlight": "^3.3.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^11.17.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
